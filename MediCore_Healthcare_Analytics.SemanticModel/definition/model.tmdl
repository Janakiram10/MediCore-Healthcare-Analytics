model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["public vw_executive_kpis","public vw_hospital_performance","public vw_no_show_analysis","public vw_patient_experience","public vw_readmission","public vw_revenue_collections"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'public vw_executive_kpis'
ref table 'public vw_hospital_performance'
ref table 'public vw_no_show_analysis'
ref table 'public vw_patient_experience'
ref table 'public vw_readmission'
ref table 'public vw_revenue_collections'

ref cultureInfo en-IN

